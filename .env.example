# .env - Environment variables for Flask app
# Copy this file to .env and configure with your actual values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=adaptive_learning_secret_key_2024

# Database Configuration
# For PostgreSQL (production-ready):
DATABASE_URL=postgresql://postgres:password@localhost:5432/adaptive_learning

# For local development with SQLite (no setup needed):
# DATABASE_URL=sqlite:///adaptive_learning.db

# API Keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Other settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800
